# Google Drive cloud sync — server-side, used by the Vercel functions in api/auth/
# Set in Vercel > Project > Settings > Environment Variables (never VITE_-prefixed:
# a VITE_ variable is bundled into the public JS).
# GOOGLE_CLIENT_SECRET comes from Google Cloud > Google Auth platform > Clients > the web client.
GOOGLE_CLIENT_SECRET=
# Optional: defaults to the project's own client ID
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Google Sheets Sync Configuration
# Sheet ID is the long string in your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
#
# IMPORTANT: Your sheets must be published to web:
# 1. Open your Google Sheet
# 2. Go to File -> Share -> Publish to web
# 3. Select "Entire Document" and "Web page"
# 4. Click "Publish"
SHEET_ID_WUTHERINGWAVE=1sIUcsunj9C2OjXFrtlzBI23ln4VkCMxUL_lBp76TqR0#gid=767812157
SHEET_ID_ENDFIELD=1jG2j13a-lKRk1CXnBdey0kN-DIfbRgrL4KiTTHo0vII#gid=2067537203
SHEET_ID_GIRLSFRONTIER=182OwAxXueZO6JS1IP-pedmqsS73MIuo2tvBGyoIEvXc#gid=
